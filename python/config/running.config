{
"driver":"{odbc driver 18 for sql server}",
"image_name":"mcr.microsoft.com/mssql/server:2019-latest",
"host_backup_dir":"/ci/backup/",
"container_backup_dir":"/var/backup/",
"container_env":["ACCEPT_EULA=Y","MSSQL_SA_PASSWORD=1234AA@PASS","MSSQL_BACKUP_DIR=/var/backup","MSSQL_AGENT_ENABLED=true"],
"pre_cmd":"/opt/mssql-tools/bin/sqlcmd -S . -U sa -P 1234AA@PASS -d master -i \"",
"ssb_dir":"/ci/backup/ssb/",
"log_dir":"/ci/log/",
"registry":"10.18.200.81:5000/",
"configpath":"/ci/backup/configfile/",
"server_alias":{"dbtxn":"dbtrans","dbpro":"db02","dbacc":"db061","dbaff12bet":"db052","dbtxnip":"dbtrans"},
"standby_db":{"dbtxn:bodb02":["dbgrp01l:bodb02","dbgrp02l:bodb02"]},
"volume_dir":"/mount/volumes/"
}
